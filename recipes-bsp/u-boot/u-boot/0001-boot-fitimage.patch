diff --git a/arch/loongarch/cpu/start.S b/arch/loongarch/cpu/start.S
index 05616f8e..0a66ce20 100644
--- a/arch/loongarch/cpu/start.S
+++ b/arch/loongarch/cpu/start.S
@@ -131,7 +131,7 @@
  * tp($r2)		link versus load offset, used to relocate absolute adresses.
  * gp($r21) 	global data pointer
  */
- #define relc_reg	tp
+ #define relc_reg	tp	// printstr 里面会用到这个
 
 	.globl	_start
 	.globl	start
@@ -142,11 +142,11 @@
 _start:
 start:
 #if !defined(CONFIG_SPL) || defined(CONFIG_SPL_BUILD)
-	li.d	t0, (1 << (24 + 32))	//set CPUCFG 0 bit24
+	li.d	t0, (1 << (24 + 32))	// MCSR0_HUGEPG_SHIFT
 	csrxchg	t0, t0, LOONGARCH_CSR_PRID
 
-	li.d	t0, (0xa << (16 + 32))	//set CPUCFG 0x13 bit16-23
-	li.d	t1, (0xff << (16 + 32))
+	li.d	t0, (0xa << (16 + 32))
+	li.d	t1, (0xff << (16 + 32))	// MCSR9_L2U_IDX_SHIFT
