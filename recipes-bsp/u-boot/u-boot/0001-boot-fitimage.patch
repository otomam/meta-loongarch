@@ -166,40 +166,41 @@ start:
 	csrxchg t0, t0, LOONGARCH_CSR_MCSR24
 
 	/* pll setting */
-	li.d	t0, 0x0001000107270e00
+	li.d	t0, 0x0001000107270e00	// 0x7270e00 = 120Mhz, MUL=0x1, DIV=0x1
