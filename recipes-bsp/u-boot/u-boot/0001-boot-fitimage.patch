-	li.d	t0, CACHED_MEMORY_ADDR | 0x1f
+	li.d	t0, CACHED_MEMORY_ADDR | 0x1f // 一致可缓存
 	csrwr	t0, LOONGARCH_CSR_DMWIN1
 
 
-/*
- * should before execution jr shutdown slave core
- * otherwise speculative execution cause error
- */
+	/*
+	* should before execution jr shutdown slave core
+	* otherwise speculative execution cause error
+	*/
 	/* clear Vint cofigure */
