From: otomam <1020793665@qq.com>
Date: Sat, 8 Nov 2025 09:35:37 +0800
Subject: [PATCH] loongarch support

---
 meta/classes-recipe/kernel-fitimage.bbclass | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/meta/classes-recipe/kernel-fitimage.bbclass b/meta/classes-recipe/kernel-fitimage.bbclass
index 0778664..6957add 100644
--- a/meta/classes-recipe/kernel-fitimage.bbclass
+++ b/meta/classes-recipe/kernel-fitimage.bbclass
@@ -22,6 +22,8 @@ def get_fit_replacement_type(d):
             replacementtype = "bzImage"
         elif uarch == "microblaze":
             replacementtype = "linux.bin"
+        elif uarch == "loongarch":
+            replacementtype = "vmlinux"
         else:
             replacementtype = "zImage"
     return replacementtype
