-
-        return b;
+    struct spretoregs_t *result;
+
+    /* Find the entry that matches or is the closest greater divisor */
+    result = (struct spretoregs_t *)bsearch(
+        (const void *)&target_divisor,
+        (const void *)spretoregs,
+        ARRAY_SIZE(spretoregs),
+        sizeof(struct spretoregs_t),
+        qspi_setting_spre);
+
+    if (result)
+        return result->div;
+
+    /* If exact match not found, bsearch returns NULL.
+     * We should find the next available slower speed (higher divisor).
+     * Note: The array is sorted by spre.
+     */
+    int i;
+    for (i = 0; i < ARRAY_SIZE(spretoregs); i++) {
+        if (spretoregs[i].spre >= target_divisor)
+            return spretoregs[i].div;
+    }
+
+    /* If target is higher than max supported divisor, use max divisor */
