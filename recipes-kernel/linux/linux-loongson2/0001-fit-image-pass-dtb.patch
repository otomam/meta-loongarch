From a4d6fec3c7cbcbba9c61da0dbba126d2fda756d8 Mon Sep 17 00:00:00 2001
From: oto <oto102079@gmail.com>
Date: Sat, 29 Nov 2025 00:22:29 +0800
Subject: [PATCH] fit image pass dtb

---
 arch/loongarch/kernel/efi.c   | 3 +++
 arch/loongarch/kernel/head.S  | 2 ++
 arch/loongarch/kernel/setup.c | 7 ++++---
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/arch/loongarch/kernel/efi.c b/arch/loongarch/kernel/efi.c
index 000825406..357f3c3da 100644
--- a/arch/loongarch/kernel/efi.c
+++ b/arch/loongarch/kernel/efi.c
@@ -51,6 +51,9 @@ void __init *efi_fdt_pointer(void)
 
 void __init efi_runtime_init(void)
 {
+	if (!efi_system_table)
+		return;
+
 	if (!efi_enabled(EFI_BOOT) || !efi_systab->runtime)
 		return;
 
diff --git a/arch/loongarch/kernel/head.S b/arch/loongarch/kernel/head.S
index c4f7de2e2..06d6b096c 100644
--- a/arch/loongarch/kernel/head.S
+++ b/arch/loongarch/kernel/head.S
@@ -73,6 +73,8 @@ SYM_CODE_START(kernel_entry)			# kernel entry point
 	st.d		a1, t0, 0
 	la.pcrel	t0, fw_arg2
 	st.d		a2, t0, 0
+	la.pcrel	t0, fw_arg3		# fdt
+	st.d		a3, t0, 0
 
 #ifdef CONFIG_PAGE_SIZE_4KB
 	li.d		t0, 0
diff --git a/arch/loongarch/kernel/setup.c b/arch/loongarch/kernel/setup.c
index 4ed745667..4574bcdc7 100644
--- a/arch/loongarch/kernel/setup.c
+++ b/arch/loongarch/kernel/setup.c
@@ -57,7 +57,7 @@
 #define SMBIOS_CORE_PACKAGE_OFFSET	0x23
 #define LOONGSON_EFI_ENABLE		(1 << 3)
 
-unsigned long fw_arg0, fw_arg1, fw_arg2;
+unsigned long fw_arg0, fw_arg1, fw_arg2, fw_arg3;
 DEFINE_PER_CPU(unsigned long, kernelsp);
 struct cpuinfo_loongarch cpu_data[NR_CPUS] __read_mostly;
 
@@ -281,8 +281,9 @@ static void __init fdt_setup(void)
 	if (acpi_os_get_root_pointer())
 		return;
 
-	/* Prefer to use built-in dtb, checking its legality first. */
-	if (!fdt_check_header(__dtb_start))
+	if (fw_arg3 != 0)
+		fdt_pointer = (void *)fw_arg3; // from u-boot
+	else if (!fdt_check_header(__dtb_start))
 		fdt_pointer = __dtb_start;
 	else
 		fdt_pointer = efi_fdt_pointer(); /* Fallback to firmware dtb */
-- 
2.52.0

