From a21c82431b51da7f4a24fb467917657f34c614ae Mon Sep 17 00:00:00 2001
From: oto <oto102079@gmail.com>
Date: Thu, 3 Sep 2026 23:52:16 +0800
Subject: [PATCH] fix compile

---
 Makefile                          | 6 +++---
 aic8800_bsp/aic_bsp_main.c        | 2 +-
 aic8800_fdrv/Makefile             | 2 +-
 aic8800_fdrv/rwnx_main.c          | 2 +-
 aic8800_fdrv/rwnx_msg_rx.c        | 4 ++--
 5 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/Makefile b/Makefile
index 6f02ee9..d86e22c 100644
--- a/Makefile
+++ b/Makefile
@@ -6,7 +6,7 @@ obj-$(CONFIG_AIC8800_BTLPM_SUPPORT) += aic8800_btlpm/
 obj-$(CONFIG_AIC8800_WLAN_SUPPORT) += aic8800_fdrv/
 obj-$(CONFIG_AIC_WLAN_SUPPORT) += aic8800_bsp/
 
-MAKEFLAGS +=-j$(shell nproc)
+# MAKEFLAGS +=-j$(shell nproc)
 
 ########## config option ##########
 export CONFIG_USE_FW_REQUEST = n
@@ -22,7 +22,7 @@ export CONFIG_PLATFORM_ROCKCHIP = n
 export CONFIG_PLATFORM_ROCKCHIP2 = n
 export CONFIG_PLATFORM_ALLWINNER = n
 export CONFIG_PLATFORM_AMLOGIC = n
-export CONFIG_PLATFORM_UBUNTU = y
+export CONFIG_PLATFORM_UBUNTU = n
 
 ifeq ($(CONFIG_PLATFORM_ROCKCHIP), y)
 ARCH = arm64
@@ -76,7 +76,7 @@ install:
 	install -p -m 644 aic8800_bsp/aic8800_bsp.ko  $(MODDESTDIR)/
 	install -p -m 644 aic8800_fdrv/aic8800_fdrv.ko  $(MODDESTDIR)/
 	install -p -m 644 aic8800_btlpm/aic8800_btlpm.ko  $(MODDESTDIR)/
-	/sbin/depmod -a ${KVER}
+#	/sbin/depmod -a ${KVER}
 
 uninstall:
 	rm -rfv $(MODDESTDIR)/aic8800_bsp.ko
diff --git a/aic8800_bsp/aic_bsp_main.c b/aic8800_bsp/aic_bsp_main.c
index 653a021..9a36d28 100644
--- a/aic8800_bsp/aic_bsp_main.c
+++ b/aic8800_bsp/aic_bsp_main.c
@@ -15,7 +15,7 @@
 #define DRV_AUTHOR            "AICSemi"
 #define DRV_VERS_MOD          "1.0"
 
-int aicwf_dbg_level_bsp = LOGERROR|LOGINFO|LOGDEBUG|LOGTRACE;
+int aicwf_dbg_level_bsp = LOGERROR;
 
 struct semaphore aicbsp_probe_semaphore;
 
diff --git a/aic8800_fdrv/Makefile b/aic8800_fdrv/Makefile
index 033b8b4..f08fdca 100644
--- a/aic8800_fdrv/Makefile
+++ b/aic8800_fdrv/Makefile
@@ -356,7 +356,7 @@ ccflags-$(CONFIG_APF) += -DCONFIG_APF
 ccflags-$(CONFIG_AUTO_POWERSAVE) += -DCONFIG_AUTO_POWERSAVE
 
 ccflags-y += -DAIC_TRACE_INCLUDE_PATH=$(src)
-MAKEFLAGS +=-j$(shell nproc)
+# MAKEFLAGS +=-j$(shell nproc)
 
 ########## Platform support list ##########
 CONFIG_PLATFORM_ROCKCHIP ?= n
diff --git a/aic8800_fdrv/rwnx_main.c b/aic8800_fdrv/rwnx_main.c
index 1e2e73d..d24ce30 100644
--- a/aic8800_fdrv/rwnx_main.c
+++ b/aic8800_fdrv/rwnx_main.c
@@ -535,7 +535,7 @@ static const int rwnx_hwq2uapsd[NL80211_NUM_ACS] = {
 
 
 extern uint8_t scanning;
-int aicwf_dbg_level = LOGERROR|LOGINFO|LOGDEBUG|LOGTRACE|LOGFW;
+int aicwf_dbg_level = LOGERROR;
 module_param(aicwf_dbg_level, int, 0660);
 #ifdef CONFIG_DYNAMIC_PWR
 int dynamic_pwr = 1;
diff --git a/aic8800_fdrv/rwnx_msg_rx.c b/aic8800_fdrv/rwnx_msg_rx.c
index a9ba841..858ca4f 100644
--- a/aic8800_fdrv/rwnx_msg_rx.c
+++ b/aic8800_fdrv/rwnx_msg_rx.c
@@ -409,7 +409,7 @@ struct fault_ctxt {
     uint32_t reg_i[13];
     uint32_t SP;
     uint32_t LR;
-    uint32_t PC;
+    uint32_t reg_PC;
     uint32_t xPSR;
     uint32_t PSP;
     uint32_t MSP;
@@ -438,7 +438,7 @@ static inline int rwnx_fw_panic_ind(struct rwnx_hw *rwnx_hw,
         printk("REG %d = [%x]\n", i, fault.reg_i[i]);
     printk("SP = [%x]\n", fault.SP);
     printk("LR = [%x]\n", fault.LR);
-    printk("PC = [%x]\n", fault.PC);
+    printk("PC = [%x]\n", fault.reg_PC);
     printk("PSP = [%x]\n", fault.PSP);
     printk("xPSR = [%x]\n", fault.xPSR);
     printk("EXC_RETURN = [%x]\n", fault.EXC_RETURN);
-- 
